from datetime import datetime, timedelta, timezone

from sqlalchemy import select

from app.core.config import settings
from app.core.limiter import reset_rate_limits
from app.models import (
    NotificationPreference, PasswordResetToken, User, UserEntitlement,
)
from app.services import auth_service

BASE = "/api/v1/auth"
EMAIL = "ada@example.com"
PASSWORD = "Correct1Horse"


# ---------------------------------------------------------------- helpers
def register(client, email=EMAIL, password=PASSWORD, **extra):
    return client.post(f"{BASE}/register", json={
        "full_name": "Ada Lovelace", "email": email, "password": password, **extra,
    })


def login(client, email=EMAIL, password=PASSWORD):
    return client.post(f"{BASE}/login", json={"email": email, "password": password})


def signed_in(client) -> dict:
    assert register(client).status_code == 201
    r = login(client)
    assert r.status_code == 200
    return r.json()


def bearer(tokens: dict) -> dict:
    return {"Authorization": f"Bearer {tokens['access_token']}"}


# ---------------------------------------------------------------- register
def test_register_creates_user_free_plan_and_preferences(client, db):
    r = register(client, email="Ada@Example.COM")
    assert r.status_code == 201
    body = r.json()
    assert body["email"] == "ada@example.com"  # lowercased
    assert "password" not in body and "password_hash" not in body

    user = db.scalar(select(User).where(User.email == "ada@example.com"))
    ent = db.scalar(select(UserEntitlement).where(UserEntitlement.user_id == user.id))
    assert ent.plan.code == "free" and ent.status == "active"
    assert db.scalar(select(NotificationPreference).where(NotificationPreference.user_id == user.id))


def test_register_duplicate_email_is_rejected_case_insensitively(client):
    assert register(client).status_code == 201
    assert register(client, email="ADA@example.com").status_code == 409


def test_register_rejects_weak_passwords(client):
    assert register(client, password="short1").status_code == 422        # too short
    assert register(client, password="onlyletters").status_code == 422   # no digit


def test_register_rejects_unknown_timezone(client):
    assert register(client, timezone="Mars/Olympus").status_code == 422


# ---------------------------------------------------------------- login and /me
def test_login_returns_tokens_and_me_works(client):
    tokens = signed_in(client)
    assert tokens["expires_in"] == settings.ACCESS_TOKEN_EXPIRE_MINUTES * 60
    me = client.get(f"{BASE}/me", headers=bearer(tokens))
    assert me.status_code == 200 and me.json()["email"] == EMAIL


def test_swagger_form_login_works(client):
    register(client)
    r = client.post(f"{BASE}/token", data={"username": EMAIL, "password": PASSWORD})
    assert r.status_code == 200 and r.json()["access_token"]


def test_me_requires_a_valid_token(client):
    assert client.get(f"{BASE}/me").status_code == 401
    assert client.get(f"{BASE}/me", headers={"Authorization": "Bearer garbage"}).status_code == 401


def test_wrong_password_and_unknown_email_look_identical(client):
    register(client)
    wrong = login(client, password="Wrong1Password")
    unknown = login(client, email="nobody@example.com")
    assert wrong.status_code == unknown.status_code == 401
    assert wrong.json() == unknown.json()  # no hint about which emails exist


def test_account_locks_after_too_many_failures(client):
    register(client)
    for _ in range(settings.MAX_FAILED_LOGINS):
        assert login(client, password="Wrong1Password").status_code == 401
    # Even the CORRECT password is refused while locked
    locked = login(client)
    assert locked.status_code == 429
    assert "Retry-After" in locked.headers


def test_lockout_expires(client, db):
    register(client)
    for _ in range(settings.MAX_FAILED_LOGINS):
        login(client, password="Wrong1Password")
    user = db.scalar(select(User).where(User.email == EMAIL))
    user.locked_until = datetime.now(timezone.utc) - timedelta(seconds=1)
    db.commit()
    assert login(client).status_code == 200


# ---------------------------------------------------------------- refresh and logout
def test_refresh_rotates_the_token(client):
    tokens = signed_in(client)
    r = client.post(f"{BASE}/refresh", json={"refresh_token": tokens["refresh_token"]})
    assert r.status_code == 200
    new = r.json()
    assert new["refresh_token"] != tokens["refresh_token"]
    # The old one is now dead
    again = client.post(f"{BASE}/refresh", json={"refresh_token": tokens["refresh_token"]})
    assert again.status_code == 401


def test_reusing_a_rotated_token_revokes_the_whole_session(client):
    tokens = signed_in(client)
    new = client.post(f"{BASE}/refresh", json={"refresh_token": tokens["refresh_token"]}).json()
    client.post(f"{BASE}/refresh", json={"refresh_token": tokens["refresh_token"]})  # replay of old token
    # Replay detected: the legitimate new token is revoked as well
    r = client.post(f"{BASE}/refresh", json={"refresh_token": new["refresh_token"]})
    assert r.status_code == 401


def test_refresh_rejects_unknown_token(client):
    assert client.post(f"{BASE}/refresh", json={"refresh_token": "nope"}).status_code == 401


def test_logout_revokes_refresh_token(client):
    tokens = signed_in(client)
    assert client.post(f"{BASE}/logout", json={"refresh_token": tokens["refresh_token"]}).status_code == 200
    r = client.post(f"{BASE}/refresh", json={"refresh_token": tokens["refresh_token"]})
    assert r.status_code == 401


def test_logout_is_idempotent(client):
    assert client.post(f"{BASE}/logout", json={"refresh_token": "never-existed"}).status_code == 200


# ---------------------------------------------------------------- password reset
def test_forgot_password_gives_same_answer_for_unknown_email(client):
    register(client)
    known = client.post(f"{BASE}/forgot-password", json={"email": EMAIL})
    unknown = client.post(f"{BASE}/forgot-password", json={"email": "nobody@example.com"})
    assert known.status_code == unknown.status_code == 200
    assert known.json() == unknown.json()


def test_reset_password_flow(client, db):
    tokens = signed_in(client)
    raw = auth_service.create_reset_token(db, EMAIL)

    r = client.post(f"{BASE}/reset-password", json={"token": raw, "new_password": "BrandNew2Pass"})
    assert r.status_code == 200

    assert login(client, password=PASSWORD).status_code == 401          # old password dead
    assert login(client, password="BrandNew2Pass").status_code == 200   # new one works
    # Reset logs out existing sessions
    assert client.post(f"{BASE}/refresh", json={"refresh_token": tokens["refresh_token"]}).status_code == 401


def test_reset_token_is_single_use(client, db):
    register(client)
    raw = auth_service.create_reset_token(db, EMAIL)
    body = {"token": raw, "new_password": "BrandNew2Pass"}
    assert client.post(f"{BASE}/reset-password", json=body).status_code == 200
    assert client.post(f"{BASE}/reset-password", json=body).status_code == 400


def test_expired_reset_token_is_rejected(client, db):
    register(client)
    raw = auth_service.create_reset_token(db, EMAIL)
    row = db.scalar(select(PasswordResetToken))
    row.expires_at = datetime.now(timezone.utc) - timedelta(minutes=1)
    db.commit()
    r = client.post(f"{BASE}/reset-password", json={"token": raw, "new_password": "BrandNew2Pass"})
    assert r.status_code == 400


def test_only_the_newest_reset_link_works(client, db):
    register(client)
    first = auth_service.create_reset_token(db, EMAIL)
    second = auth_service.create_reset_token(db, EMAIL)
    assert client.post(f"{BASE}/reset-password",
                       json={"token": first, "new_password": "BrandNew2Pass"}).status_code == 400
    assert client.post(f"{BASE}/reset-password",
                       json={"token": second, "new_password": "BrandNew2Pass"}).status_code == 200


# ---------------------------------------------------------------- change password
def test_change_password(client):
    tokens = signed_in(client)
    r = client.post(f"{BASE}/change-password", headers=bearer(tokens),
                    json={"current_password": PASSWORD, "new_password": "BrandNew2Pass"})
    assert r.status_code == 200
    assert login(client, password=PASSWORD).status_code == 401
    assert login(client, password="BrandNew2Pass").status_code == 200


def test_change_password_needs_the_right_current_password(client):
    tokens = signed_in(client)
    r = client.post(f"{BASE}/change-password", headers=bearer(tokens),
                    json={"current_password": "Wrong1Password", "new_password": "BrandNew2Pass"})
    assert r.status_code == 400


def test_change_password_rejects_same_password(client):
    tokens = signed_in(client)
    r = client.post(f"{BASE}/change-password", headers=bearer(tokens),
                    json={"current_password": PASSWORD, "new_password": PASSWORD})
    assert r.status_code == 400


# ---------------------------------------------------------------- profile and delete
def test_update_profile(client):
    tokens = signed_in(client)
    r = client.patch(f"{BASE}/me", headers=bearer(tokens),
                     json={"full_name": "Ada King", "default_currency": "ngn", "timezone": "Africa/Lagos"})
    assert r.status_code == 200
    body = r.json()
    assert body["full_name"] == "Ada King"
    assert body["default_currency"] == "NGN"  # uppercased
    assert body["timezone"] == "Africa/Lagos"


def test_update_profile_rejects_bad_timezone_and_unknown_fields(client):
    tokens = signed_in(client)
    assert client.patch(f"{BASE}/me", headers=bearer(tokens), json={"timezone": "Nope/Nope"}).status_code == 422
    assert client.patch(f"{BASE}/me", headers=bearer(tokens), json={"is_demo": True}).status_code == 422


def test_delete_account_removes_user_and_invalidates_token(client, db):
    tokens = signed_in(client)
    assert client.delete(f"{BASE}/me", headers=bearer(tokens)).status_code == 200
    assert db.scalar(select(User).where(User.email == EMAIL)) is None
    assert client.get(f"{BASE}/me", headers=bearer(tokens)).status_code == 401
    assert login(client).status_code == 401


def test_demo_account_cannot_be_deleted(client, db):
    tokens = signed_in(client)
    user = db.scalar(select(User).where(User.email == EMAIL))
    user.is_demo = True
    db.commit()
    assert client.delete(f"{BASE}/me", headers=bearer(tokens)).status_code == 403


# ---------------------------------------------------------------- rate limiting
def test_login_is_rate_limited(client):
    settings.RATE_LIMIT_ENABLED = True
    reset_rate_limits()
    for _ in range(10):
        # unknown email, so the per-account lockout can't interfere with this test
        assert login(client, email="nobody@example.com").status_code == 401
    assert login(client, email="nobody@example.com").status_code == 429